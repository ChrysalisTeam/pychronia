# Copy this file to ".env" (untracked) and uncomment what you need: these values are read by the DEV settings
# (config/settings/game_dev.py and cms_dev.py) and PROD settings (prod_game.py and prod_cms.py).
# Values of a single site may go in ".env.game" or ".env.cms" (untracked too) instead, they take precedence over
# ".env", and real environment variables take precedence over all these files.
# Beware: "$" characters in values are interpolated (escape them as "\$"), and "#" is NOT a comment after a value.

# SQL DB of the game site (default: sqlite file pychronia_game/tests/django.db)
#GAME_DATABASE_URL=mysql://root@localhost/pychronia_dev

# ZODB of the game site, via RelStorage (default: ZODB file pychronia_game/tests/gamedata.fs)
#ZODB_URL=mysql://root@localhost?driver=MySQLdb#pychronia_zodb_dev

# SQL DB of the CMS site (default: mysql://root:root@127.0.0.1:3306/chrysaliscms_dev)
#CMS_DATABASE_URL=mysql://root@localhost/chryscms_dev


##### PROD SERVERS ONLY (config/settings/prod_cms.py and prod_game.py, see config/settings/_prod_base.py) #####
# Special characters of passwords in URLs must be percent-encoded (eg. "@" -> "%40", "#" -> "%23").

# picks the site served by this checkout, for the root manage.py, config/wsgi.py and the bin/ scripts; only read
# from ".env" (not from site files), if both sites share a checkout set it in the web server config and crontab
#DJANGO_SETTINGS_MODULE=config.settings.prod_cms

#SECRET_KEY=change-me
#ALLOWED_HOSTS=mydomain.com,www.mydomain.com
#SITE_DOMAIN=https://mydomain.com
#SESSION_COOKIE_DOMAIN=.mydomain.com
#SERVER_EMAIL=webmaster@mydomain.com
#ADMIN_EMAILS=webmaster@mydomain.com
#EMAIL_URL=smtp://localhost:25
#CACHE_URL=pymemcache://127.0.0.1:11211?key_prefix=myprefix
#MEDIA_ROOT=/path/to/docroot/media
#STATIC_ROOT=/path/to/docroot/static
# default: SITE_DOMAIN
#CSRF_TRUSTED_ORIGINS=https://mydomain.com
# only if a proxy forwards HTTPS requests as plain HTTP, with a X-Forwarded-Proto header
#BEHIND_TLS_PROXY=true

# CMS site: CMS_DATABASE_URL above
# game site: GAME_DATABASE_URL and ZODB_URL above, plus either the Chrysalis game data repository (whose fixture scripts only alter the DEMO game in prod)...
#CHRYSALIS_DIR=/path/to/Chrysalis
# ... or a generic tree of game assets
#GAME_FILES_ROOT=/path/to/game_files/
#GAME_INITIAL_DATA_PATH=/path/to/game_files/game_initial_data.yaml
# words among which initial passwords of players are chosen (REQUIRED, here or in config/settings/local_game.py)
#PASSWORDS_POOL=acacia,betula,celtis
#GAME_ALLOW_ENFORCED_LOGIN=true
